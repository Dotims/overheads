# Postgres connection string. Never commit the real one.
#
# Supabase since 2026-08-24, and it must be the Session pooler rather than the Direct
# connection: the direct host resolves to IPv6 only, which neither a GitHub runner nor a
# machine with IPv6 switched off can reach.
DATABASE_URL=postgresql://postgres.<ref>:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Guards /api/ingest/olx, which writes. Any long random string; generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
INGEST_TOKEN=

# The Telegram bot, from @BotFather, and the chat it writes to. Set together or not at
# all: with either missing, a collection round finishes silently instead of failing, which
# is what the cloud schedule needs. Find the chat id by messaging the bot once and reading
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# What is worth a message, on top of the listing being in budget. These are the
# dashboard's filters kept a second time: the dashboard's own live in one browser's local
# storage, and the site is public, so a copy the page could write to is a copy anybody
# could write to. Changing the filters on the site does not change these.
#
# Blank means no bound. A listing the portal gave no floor area for passes a floor-area
# bound, the same way the dashboard treats it. A value that is not a number stops the
# round rather than being ignored.
NOTIFY_HIDDEN_DISTRICTS=
NOTIFY_PRIVATE_ONLY=false
NOTIFY_MIN_COST_PLN=
NOTIFY_MAX_COST_PLN=
NOTIFY_MIN_AREA_M2=
NOTIFY_MAX_AREA_M2=
NOTIFY_MIN_ROOMS=
NOTIFY_MAX_ROOMS=

# Optional, for the database tests. Must be a throwaway: they empty the tables.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# The model that reads costs out of descriptions. Entirely optional: with none of this
# set, every command still works and listings are priced by the rules alone.
#
# Two ways to provide one, and the hosted one wins when both are set.
#
# 1. Hosted, for the collection round. The round has no graphics card, and a listing has
#    to be read before it is announced or Telegram sends a figure the dashboard later
#    corrects. Any OpenAI-compatible endpoint: Groq, Cerebras, OpenRouter. Free tiers cap
#    tokens per minute well before requests, hence the twelve second gap the code leaves
#    between listings; LLM_DELAY_MS overrides it.
#    Groq keys are free and need no card: https://console.groq.com
#
#    Check the endpoint's own model list before picking a name rather than trusting one
#    written down here: measured on 2026-08-25, Groq no longer served the llama model this
#    file first named. Reasoning models are fine, but note their deliberation counts
#    against max_tokens, which is why transport.ts allows a far larger budget than the
#    answer needs. On 6 hand-checked listings openai/gpt-oss-20b scored 9/12 and
#    openai/gpt-oss-120b 8/12, against 11/12 for the local qwen3:4b - a small sample, but
#    enough to say the hosted model is chosen for running unattended, not for accuracy.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_DELAY_MS=12000
#
# 2. Local, for a backfill. No key, no quota, and the only sane way to read thousands of
#    stored listings at once. Needs `ollama serve` running and `ollama pull <name>`.
#    qwen3:4b was measured against 29 hand-checked listings, beat qwen2.5:7b on both
#    accuracy and speed, and fits a 6 GB card.
OLLAMA_MODEL=qwen3:4b
# Only when the local model runs somewhere other than this machine.
# OLLAMA_HOST=http://127.0.0.1:11434
